# Desktop container image for computerd.
#
# Provides a complete X11 virtual desktop (Xvfb + Fluxbox + x11vnc +
# noVNC + websockify + xdotool + scrot + ImageMagick + xclip + wmctrl)
# alongside the FUSE-backed computerd workspace daemon.
#
# Build from the repository root after `npm run build`:
#   docker build -f packages/computerd/Dockerfile.desktop -t computerd-desktop:latest .
#
# Run standalone:
#   docker run --rm -it --privileged \
#     -p 8080:8080 -p 5900:5900 -p 6080:6080 \
#     computerd-desktop:latest

FROM node:22-bookworm-slim

RUN apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ca-certificates \
    curl \
    dbus-x11 \
    fluxbox \
    fonts-liberation \
    fuse \
    git \
    imagemagick \
    libfuse2 \
    novnc \
    procps \
    python3 \
    scrot \
    websockify \
    wmctrl \
    x11-utils \
    x11-xserver-utils \
    x11vnc \
    xauth \
    xclip \
    xdotool \
    xsel \
    xterm \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/computerd
COPY packages/computerd/dist/cli/ /opt/computerd/

RUN mkdir -p /workspace /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

ENV PORT=8080 \
    MOUNT_POINT=/workspace \
    FUSE_MOUNT=auto \
    DESKTOP_ENABLED=1 \
    DISPLAY=:99 \
    DESKTOP_RESOLUTION=1280x720x24 \
    DESKTOP_WM=fluxbox \
    VNC_PORT=5900 \
    NOVNC_PORT=6080

EXPOSE 8080 5900 6080

CMD ["/usr/local/bin/node", "/opt/computerd/computerd.bundle.mjs"]
